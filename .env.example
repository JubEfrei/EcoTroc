# Configuration EcoTroc

# Turso Database Configuration
TURSO_CONNECTION_URL=libsql://your-database-name-xxxx.turso.io
TURSO_AUTH_TOKEN=eyJhbGc...your-token-here

# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=your_secret_key_here

# Pour Vercel, définissez ces variables d'environnement dans le tableau de bord:
